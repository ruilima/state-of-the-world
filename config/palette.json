{
  "description": "World Vitals palette. The CSS tokens in public/styles.css must use these values (tested). Each entry in `pairs` is a combination used on the page; `kind` sets the WCAG threshold: text = 4.5, graphic = 3.",
  "colors": {
    "tile": "#1F2119",
    "tube": "#D6D1B1",
    "tube-low": "#A6A084",
    "paper": "#CDC2A2",
    "ink": "#2B2519",
    "ink-faded": "#4A4536",
    "stable": "#8EA35B",
    "caution": "#C68A2E",
    "danger-light": "#E0705A",
    "stable-ink": "#384D1C",
    "caution-ink": "#663D0B",
    "danger-ink": "#8A2C20"
  },
  "pairs": [
    {
      "fg": "tube",
      "bg": "tile",
      "kind": "text",
      "use": "main text in the room"
    },
    {
      "fg": "tube-low",
      "bg": "tile",
      "kind": "text",
      "use": "secondary text in the room"
    },
    {
      "fg": "stable",
      "bg": "tile",
      "kind": "text",
      "use": "STABLE on the monitor and inventory"
    },
    {
      "fg": "caution",
      "bg": "tile",
      "kind": "text",
      "use": "CAUTION on the monitor and inventory"
    },
    {
      "fg": "danger-light",
      "bg": "tile",
      "kind": "text",
      "use": "DANGER on the monitor (trace and word)"
    },
    {
      "fg": "ink",
      "bg": "paper",
      "kind": "text",
      "use": "file text"
    },
    {
      "fg": "ink-faded",
      "bg": "paper",
      "kind": "text",
      "use": "secondary file text"
    },
    {
      "fg": "stable-ink",
      "bg": "paper",
      "kind": "text",
      "use": "STABLE stamp"
    },
    {
      "fg": "caution-ink",
      "bg": "paper",
      "kind": "text",
      "use": "CAUTION stamp"
    },
    {
      "fg": "danger-ink",
      "bg": "paper",
      "kind": "text",
      "use": "DANGER stamp and values over a threshold"
    },
    {
      "fg": "ink-faded",
      "bg": "paper",
      "kind": "graphic",
      "use": "chart axes and map outline"
    },
    {
      "fg": "tube-low",
      "bg": "tile",
      "kind": "graphic",
      "use": "monitor frame and inventory boxes"
    }
  ]
}
